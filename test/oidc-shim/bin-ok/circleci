#!/usr/bin/env bash
# Fake CircleCI job-runtime CLI, standing in for `circleci run oidc get
# --claims '{"aud":"<x>"}'` for local testing (a real OIDC token cannot be
# minted outside an actual CircleCI job -- see the README's test section).
# Prints an obviously-fake, non-cryptographic three-segment token to stdout
# on success, embedding the requested `aud` so tests can assert the
# audience actually round-tripped end to end through the real shim code.
set -euo pipefail

# Test-only instrumentation: if OIDC_SHIM_TEST_MINT_LOG is set (inherited
# from the environment the shim's start script -- and hence the Python
# server's subprocess call -- was launched with), record that a mint was
# actually attempted. Used by run_tests.sh to assert that a request which
# fails auth never reaches this binary at all.
if [ -n "${OIDC_SHIM_TEST_MINT_LOG:-}" ]; then
    echo "mint-called: $*" >> "${OIDC_SHIM_TEST_MINT_LOG}"
fi

if [ "${1:-}" = "run" ] && [ "${2:-}" = "oidc" ] && [ "${3:-}" = "get" ] && [ "${4:-}" = "--claims" ]; then
    claims="${5:-}"
    aud="$(python3 -c "import json,sys; print(json.loads(sys.argv[1])['aud'])" "${claims}")"
    header="$(printf '{"alg":"none","typ":"JWT"}' | base64 | tr -d '=\n')"
    payload="$(printf '{"aud":"%s","iss":"https://oidc.circleci.com/org/FAKE-ORG-ID","sub":"org/FAKE-ORG-ID/project/FAKE-PROJECT-ID/user/FAKE-USER-ID"}' "${aud}" | base64 | tr -d '=\n')"
    echo "${header}.${payload}.FAKESIGNATURE"
    exit 0
fi

echo "fake circleci (bin-ok): unexpected invocation: $*" >&2
exit 2
